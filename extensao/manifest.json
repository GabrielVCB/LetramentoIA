{
  "manifest_version": 3,
  "name": "Sentinela — Governança e Letramento em IA",
  "version": "1.0.0",
  "description": "Analisa localmente o que você digita em IAs públicas, avisa sobre dados sensíveis e registra apenas o alerta no painel de governança.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinela"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["detectores.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
