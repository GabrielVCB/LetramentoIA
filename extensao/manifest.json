{
  "manifest_version": 3,
  "name": "Sentinela — Governança e Letramento em IA",
  "version": "2.7",
  "description": "Analisa localmente o que você digita, cola ou anexa em IAs públicas, avisa antes do envio e registra apenas o alerta no painel de governança.",
  "permissions": ["storage", "offscreen"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": ["https://sentinela-r7ge.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinela"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://copilot.cloud.microsoft/*",
        "https://copilot.microsoft.com/*",
        "https://www.copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*"
      ],
      "js": ["detectores.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
